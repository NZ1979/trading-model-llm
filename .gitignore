# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Tools
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Local secrets / env
.env
*.bak
*.bak_*

# Local SQLite (regenerated on the VPS, not committed)
trading.db
*.db-journal

# Daily journals (generated at runtime)
journals/

# Word document artifacts (regenerable from scripts/build_overview_doc.js)
*.docx

# Local build helpers (regeneratable)
node_modules/
package-lock.json
package.json
gap-and-go.tar.gz

# Pytest tempdir artifacts (created by --basetemp option)
pytest-cache-files-*/


# Dynamic watchlist — generated daily by data/watchlist_builder.py
# or pulled from the VPS. Per-environment, not source.
config/watchlist_dynamic.json
boot_*.log

# M2 replay harness — fixtures (data, not code) and LLM response cache.
# The fixtures README at data/replay/fixtures/README.md documents the
# export procedure (Rule 26-compliant cross-fork data handoff).
data/replay/fixtures/*.sqlite
data/replay/fixtures/*.json
data/replay/fixtures/news/
.replay_cache/
docs/reports/replay_*.md
docs/reports/replay_results.db

# Session run logs (Tee-Object output from replay runs / verifier scripts).
# Regenerable; noisy; not source.
docs/sessions/*.log
# Tick corpus (v4 feed daemon). SQLite WAL sidecars are NOT covered by the
# *.db-journal rule above - WAL mode produces -wal/-shm instead. Multi-GB.
*.db-wal
*.db-shm
data/ticks/
data/snapshots/
# Option-chain rolling store (data/chain_store.py). Same treatment as
# data/ticks/: a local SQLite store, not source. Open interest is a daily
# snapshot, so this file is NOT regenerable after the fact - back it up
# outside git rather than committing a growing binary.
data/chains/

# Live watcher output (scripts/watch.py). Rewritten every few seconds while
# the watcher runs; pure runtime state, never source.
data/live/

# Word/Excel lock files (~$FILENAME) created while a doc is open
~$*

# Persistent bar store (data/price_store.py). Local SQLite, not source.
# UNLIKE data/chains/, this one IS regenerable: scripts/backfill_bars.py
# re-pulls it from Alpaca, and writes are UPSERTs so a re-run is idempotent.
# Excluded because it grows without bound, not because it is precious.
data/bars/
